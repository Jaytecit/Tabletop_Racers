; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="(not) THE REAL THING"
config/version="2.22.23"
run/main_scene="res://scenes/app.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Room Run · Miniature Grand Prix"
config/features=PackedStringArray("4.7")
run/main_scene.loading_benchmark="res://tests/autopilot/loading_bootstrap.tscn"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1200
window/size/viewport_height=800
window/size/window_width_override=1200
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="tabletop-racers"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/asset_manager/plugin.cfg")

