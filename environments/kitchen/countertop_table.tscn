[sub_resource type="Shader" id="Shader_tma32"]
code = "shader_type spatial;
render_mode cull_disabled;
uniform bool cloth = false;
varying vec2 world; varying float height;
void vertex() { height = (MODEL_MATRIX * vec4(VERTEX,1.0)).y; world = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xz; }
void fragment() {
	if (cloth) {
		vec2 cell = floor(world * 1.25);
		float check = mod(cell.x + cell.y, 2.0);
		float weave = step(0.85, fract(world.x * 8.0)) * 0.025;
		ALBEDO = mix(vec3(0.92,0.84,0.65), vec3(0.72,0.46,0.38), check * 0.38) + weave;
	} else {
		float grain = sin(world.x * 4.2 + sin(world.y * 0.18) * 1.1);
		float seam = step(0.97, fract(world.x / 7.0));
		ALBEDO = vec3(0.72,0.49,0.28) + grain * 0.035 - seam * 0.06;
	}
	if (height > 3.8) { vec2 tile = fract(world / 5.0); float joint = max(step(0.96,tile.x),step(0.96,tile.y)); ALBEDO = mix(vec3(0.90,0.86,0.70),vec3(0.55,0.64,0.65),joint); } ROUGHNESS = 0.9;
}
"

