static func build() -> void:
	var letters: Dictionary = GLYPHS.duplicate()
	for capital: String in GLYPHS:
		if capital.length()==1 and capital>="A" and capital<="Z": letters[capital.to_lower()] = GLYPHS[capital]
	var image: Image = Image.create(128,64,false,Image.FORMAT_RGBA8)
	image.fill(Color(0,0,0,0))
	var descriptor: String = "info face=\"Felt Arcade\" size=8 bold=0 italic=0 charset=\"\" unicode=1 stretchH=100 smooth=0 aa=1 padding=0,0,0,0 spacing=1,1\ncommon lineHeight=9 base=7 scaleW=128 scaleH=64 pages=1 packed=0\npage id=0 file=\"arcade_font.png\"\nchars count=%d\n" % letters.size()
	var index: int = 0
	for character: String in letters:
		var origin: Vector2i = Vector2i(index%16*8,int(floorf(float(index)/16.0))*8)
		var rows: PackedStringArray = letters[character].split("/")
		for y: int in range(7):
			for x: int in range(5):
				if rows[y][x]=="1": image.set_pixel(origin.x+x,origin.y+y,Color.WHITE)
		descriptor += "char id=%d x=%d y=%d width=5 height=7 xoffset=0 yoffset=0 xadvance=6 page=0 chnl=15\n" % [character.unicode_at(0),origin.x,origin.y]
		index += 1
	assert(image.save_png("res://assets/arcade/arcade_font.png")==OK)
	var file: FileAccess = FileAccess.open("res://assets/arcade/arcade_font.fnt",FileAccess.WRITE)
	assert(file!=null)
	file.store_string(descriptor)
	file.close()
