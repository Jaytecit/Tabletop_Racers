[sub_resource type="Shader" id="Shader_q3n1x"]
code = "shader_type spatial; varying vec3 world_pos; void vertex(){world_pos=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;} float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);} void fragment(){float grain=hash(floor(world_pos.xz*100.0)); float weave=sin(world_pos.x*150.0)*sin(world_pos.z*150.0); ALBEDO=vec3(0.013,0.19,0.12)*(0.91+grain*0.16+weave*0.025); ROUGHNESS=1.0;}"

